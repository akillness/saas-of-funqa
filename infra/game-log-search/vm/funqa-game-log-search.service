[Unit]
Description=FunQA game-log search service stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/funqa
EnvironmentFile=/etc/funqa/game-log-search.env
ExecStart=/usr/bin/docker compose --project-name funqa-game-log-search --env-file /etc/funqa/game-log-search.env -f /opt/funqa/infra/game-log-search/vm/compose.yaml up --detach --build --remove-orphans --wait --wait-timeout 900
ExecReload=/usr/bin/docker compose --project-name funqa-game-log-search --env-file /etc/funqa/game-log-search.env -f /opt/funqa/infra/game-log-search/vm/compose.yaml up --detach --build --remove-orphans --wait --wait-timeout 900
ExecStop=/usr/bin/docker compose --project-name funqa-game-log-search --env-file /etc/funqa/game-log-search.env -f /opt/funqa/infra/game-log-search/vm/compose.yaml down --remove-orphans
TimeoutStartSec=930
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
