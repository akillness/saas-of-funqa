# 로컬 개발용. Firebase Functions 런타임 값은 이 두 변수로 바뀌지 않는다 —
# scripts/build-functions.mjs 가 명시적으로 고정하며, 각각
# FUNCTIONS_EMBEDDING_MODEL_ID / FUNCTIONS_EMBEDDING_OUTPUT_DIMENSION 으로만
# 의도적 override 가 가능하다 (예: 스테이징 백엔드).
# gemini-embedding-001 은 텍스트 전용이라 이미지 임베딩이 불가능하므로 Scene Search 가 깨진다.
# 그래서 build-functions.mjs 는 FUNCTIONS_EMBEDDING_MODEL_ID 로 텍스트 전용 모델이
# 지정되면 빌드를 실패시킨다. 아래 ambient 값은 검사 대상이 아니라 아예 무시된다.
EMBEDDING_MODEL_ID=gemini-embedding-2
EMBEDDING_OUTPUT_DIMENSION=1536
RAG_LIVE_EMBEDDINGS=1
SEARCH_TOP_K=5
RAG_STORE_PATH=./.runtime/rag-store.json
# RAG_STORE_PATH=firestore   ← Firebase Functions 배포 시 이 값으로 교체

# Server-only Patch Desk boundary. Keep this exact loopback URL for local/emulator use.
# Deployed App Hosting intentionally leaves the variable unset until a reachable VM is activated.
GAME_LOG_SEARCH_SERVICE_URL=http://127.0.0.1:7400

# Local Compose controls. Set an exact Ollama model identifier before starting the stack.
GAME_LOG_SEARCH_SYNTHESIS_MODEL=
GAME_LOG_SEARCH_SYNTHESIS_MODEL_QUANTIZATION=
GAME_LOG_SEARCH_BUILD_ID=local-compose
GAME_LOG_SEARCH_FIXTURE_MODE=1
GAME_LOG_SEARCH_FAULT_MODE=none

# Search engine selection for the web Patch Desk API.
#   genkit → in-process Genkit/Gemini over the embedded sim corpus (needs GEMINI_API_KEY at runtime)
#   local  → proxy to the VM CocoIndex/pgvector/Ollama service at GAME_LOG_SEARCH_SERVICE_URL
# Unset: local iff GAME_LOG_SEARCH_SERVICE_URL is set, else genkit.
GAME_LOG_SEARCH_ENGINE=local
GEMINI_MODEL_ID=gemini-2.5-flash
