# 로컬 개발용. Firebase Functions 런타임 값은 이 두 변수로 바뀌지 않는다 —
# scripts/build-functions.mjs 가 명시적으로 고정하며, 각각
# FUNCTIONS_EMBEDDING_MODEL_ID / FUNCTIONS_EMBEDDING_OUTPUT_DIMENSION 으로만
# 의도적 override 가 가능하다. 단, 모델은 단일 임베딩 공간을 지키기 위해
# gemini-embedding-2(선택적 models/ 접두사)만 허용한다. 아래 ambient 값은 배포
# 빌드의 검사 대상이 아니라 아예 무시된다.
# 그 밖의 배포 전용 비밀 아닌 설정은 FUNCTIONS_GEMINI_MODEL_ID,
# FUNCTIONS_CORS_ALLOWED_ORIGINS, FUNCTIONS_SCENE_STORAGE_BUCKET,
# FUNCTIONS_SCENE_TENANT_ID,
# FUNCTIONS_ADMIN_EMAILS 로 build-functions.mjs에 명시적으로 전달한다.
EMBEDDING_MODEL_ID=gemini-embedding-2
EMBEDDING_OUTPUT_DIMENSION=1536
EMBED_TIMEOUT_MS=20000
RAG_LIVE_EMBEDDINGS=1
SEARCH_TOP_K=5
SCENE_ANSWER_SCORE_FLOOR=0.35
SCENE_ANSWER_MIN_DOCUMENT_MARGIN=0.02
RAG_STORE_PATH=./.runtime/rag-store.json
# RAG_STORE_PATH=firestore   ← Firebase Functions 배포 시 이 값으로 교체

GEMINI_MODEL_ID=gemini-2.5-flash
