{
  "name": "saas-of-funqa",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "apps/*",
    "packages/*",
    "functions"
  ],
  "scripts": {
    "build": "npm run build:web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "build:functions": "node scripts/build-functions.mjs",
    "dev:apphosting": "npm run build:functions && npx firebase-tools@latest emulators:start --only apphosting,functions,auth,firestore,storage",
    "dev": "sh -c 'cd apps/web && node_modules/.bin/next dev'",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": "tsx apps/api/src/index.ts",
    "dev:functions": "npm run build:functions && npx firebase-tools@latest emulators:start --only functions,auth,firestore,storage",
    "build:web": "npm --prefix apps/web install --workspaces=false && npm --prefix apps/web run build",
    "deploy:apphosting": "npx firebase-tools@latest deploy --only apphosting",
    "deploy:functions": "npm run build:functions && npx firebase-tools@latest deploy --only functions,firestore:rules,firestore:indexes,storage",
    "seed:demo": "tsx scripts/seed-demo-rag.ts",
    "eval:consensus": "node --import tsx scripts/run-consensus-eval.ts",
    "smoke:functions": "bash scripts/smoke-functions.sh",
    "start": "npm --workspace @funqa/web run start",
    "typecheck": "npm --workspace @funqa/api run typecheck && npm --workspace @funqa/web run typecheck",
    "smoke:rag": "DISABLE_AUTH=true SECRET_ENCRYPTION_KEY=${SECRET_ENCRYPTION_KEY:-local-dev-secret-key-32-bytes} tsx scripts/smoke-rag.ts",
    "wiki:bootstrap": "bash scripts/bootstrap-vault.sh knowledge",
    "wiki:ingest-url": "bash scripts/ingest-url.sh knowledge",
    "wiki:new-query": "bash scripts/new-query-note.sh knowledge",
    "wiki:lint": "python3 scripts/lint-wiki.py knowledge",
    "wiki:lint:json": "python3 scripts/lint-wiki.py knowledge --format json",
    "verify:scene-scenarios": "node scripts/verify-scene-scenarios.mjs",
    "verify:scene-scenario-sources": "tsx scripts/verify-scene-scenario-sources.ts",
    "verify:scene-scenario-suite": "npm run verify:scene-scenarios && npm run verify:scene-scenario-sources",
    "run:scene-scenarios": "tsx scripts/run-live-scene-scenarios.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@google/design.md": "^0.1.1",
    "esbuild": "^0.25.9",
    "eslint": "^10.4.0",
    "prettier": "^3.8.3",
    "tsx": "4.21.0",
    "typescript": "6.0.2",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "firebase": "^12.12.0",
    "firebase-admin": "^13.8.0"
  }
}
